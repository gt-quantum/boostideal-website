---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'BoostIdeal — Content',
  url: 'https://boostideal.com/blog',
};

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<Base
  title="Content — BoostIdeal"
  description="Writing on account scoring, lead scoring, and making HubSpot focus on the right revenue."
  jsonLd={jsonLd}
>
  <section class="border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">Content</p>
      <h1 class="mt-2 text-4xl font-semibold leading-tight md:text-5xl">
        Writing on scoring, focus, and missed revenue.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Field notes from working inside HubSpot with B2B teams — what actually works
        when you want your reps to focus on the right accounts.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    {posts.length === 0 ? (
      <p class="text-muted">No posts yet.</p>
    ) : (
      <ul class="grid gap-10">
        {posts.map((post) => (
          <li>
            <article class="flex flex-col gap-2 border-b border-border pb-10">
              <p class="text-xs uppercase tracking-widest text-muted">
                <time datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate)}
                </time>
                {post.data.tags.length > 0 && (
                  <>
                    <span class="mx-2">·</span>
                    <span>{post.data.tags.join(', ')}</span>
                  </>
                )}
              </p>
              <h2 class="text-2xl font-semibold md:text-3xl">
                <a href={`/blog/${post.id}/`} class="hover:underline">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-muted">{post.data.description}</p>
              <p>
                <a
                  href={`/blog/${post.id}/`}
                  class="text-sm font-medium text-accent hover:underline"
                >
                  Read →
                </a>
              </p>
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
