---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Cta from '../components/Cta.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BoostIdeal',
  url: 'https://boostideal.com',
};
---
<Base
  title="BoostIdeal — Placeholder Homepage"
  description="BoostIdeal homepage scaffold. Real copy and design arrive in the next phase."
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="BoostIdeal"
    headline="Placeholder homepage"
    sub="The Astro + Tailwind v4 scaffold is in place. Real content and design are coming."
  >
    <Cta label="Get in touch" />
  </Hero>

  <Section>
    <h2 class="text-2xl font-semibold">What lives here later</h2>
    <p class="mt-2 text-muted">
      Real hero copy, value props, social proof, product primer, and CTA sections will
      replace this placeholder during the design + copy pass.
    </p>
  </Section>
</Base>
