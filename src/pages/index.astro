---
import Base from '../layouts/Base.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BoostIdeal',
  url: 'https://boostideal.com',
  description: 'Account & Lead Scoring for HubSpot teams.',
};

const metrics = [
  { value: '4X', label: 'Pipeline in 6 Months' },
  { value: '2.5X', label: 'Demand Gen ROI' },
  { value: '30%', label: 'Higher Conversion Rates' },
  { value: '40%', label: 'Net Revenue Retention' },
];

const problemPoints = [
  'work the easiest accounts',
  'chase deals that will not close',
  'ignore expansion sitting in their customers',
  'miss early signs of churn',
];

const systemSignals = [
  'where to focus',
  'what matters right now',
  'what to do next',
];

const systemOutcomes = [
  'works the right accounts',
  'catches expansion early',
  'avoids wasted effort',
  'acts at the right time',
];

const services = [
  {
    name: 'What matters right now',
    body: 'A clear list of accounts and customers worth attention.',
  },
  {
    name: 'What does not',
    body: 'Low value noise gets filtered out.',
  },
  {
    name: 'What to do next',
    body: 'Simple actions your team can take immediately.',
  },
];

const fitChecklist = [
  'Your team is active in HubSpot but not sure what to prioritize',
  'Deals are slipping and you are not catching them early enough',
  'You have customers who could expand but nobody is tracking it',
  'Reps are deciding what to work based on gut, not data',
  'You have good accounts in your CRM that are not getting touched',
  'You have tried scoring before but it never got used',
];

const oldWayMethods = [
  'scoring that never updates',
  'workflows that trigger on everything',
  'dashboards no one checks',
  'reps deciding based on gut',
];

const oldWayOutcomes = [
  'good accounts get ignored',
  'bad deals get attention',
  'customers ready to expand get missed',
  'problems show up too late',
];

const weeklyFocus = [
  '14 accounts showing real buying signals',
  '5 deals that are at risk and need attention',
  '6 customers ready for expansion',
  '3 accounts that look active but should be ignored',
];

const signalFlow = [
  {
    title: 'A signal shows up with context',
    body: 'What changed. Why it matters. How urgent it is.',
    example: '3 new hires in operations. Likely buying window.',
  },
  {
    title: 'Speed to lead',
    body: 'High intent leads are flagged immediately with context. Your team knows who this is and why it matters.',
  },
  {
    title: 'A clear next step',
    body: 'No guessing. Reach out. Follow up. Expand. Or wait.',
  },
  {
    title: 'A message is ready',
    body: 'If outreach makes sense, it is drafted. Your team reviews and sends.',
  },
  {
    title: 'Expansion is surfaced',
    body: 'Customers ready to grow are highlighted early. No more missed opportunities.',
  },
  {
    title: 'Risk is flagged early',
    body: 'Deals and customers that are slipping get attention before it is too late.',
  },
  {
    title: 'Noise is removed',
    body: 'If it does not matter, your team never sees it.',
  },
];

const howItRunsActions = [
  'organize your accounts and customers',
  'surface real opportunities',
  'highlight risk early',
  'guide your team on what to do',
];

const teamSees = [
  'a clear list of where to focus',
  'fewer distractions',
  'simple next steps',
];

const youGet = [
  'more deals from the pipeline you already have',
  'more expansion from existing customers',
  'fewer deals slipping through',
  'less wasted effort',
];

const notNeeded = [
  'You do not need more data',
  'You do not need more automation',
  'You do not need another dashboard',
];

const offerIncludes = [
  'clear prioritization across accounts and customers',
  'visibility into missed opportunities',
  'simple next steps for your team',
  'setup inside HubSpot so it runs',
];
---
<Base
  title="BoostIdeal — Account & Lead Scoring for HubSpot Teams"
  description="Account & Lead Scoring for HubSpot teams. We fix what your team focuses on so the right deals, expansions, and customers get attention."
  jsonLd={jsonLd}
>
  <!-- Section 1 — Hero -->
  <section class="border-b border-border">
    <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-6 py-24 text-center">
      <p class="text-xs uppercase tracking-widest text-muted">
        Account &amp; Lead Scoring for HubSpot Teams
      </p>
      <h1 class="text-4xl font-semibold leading-tight md:text-6xl">
        Revenue is right in front of you. We show you where it is and what to do next.
      </h1>
      <p class="max-w-2xl text-lg text-muted">
        Your team is working hard. They are just working the wrong things. Fix what your
        team is focusing on across pipeline deals and customers.
      </p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          data-open-contact
          class="rounded-md bg-accent px-6 py-3 font-medium text-accent-fg"
        >
          See what you are missing
        </button>
        <a
          href="#how-it-works"
          class="rounded-md border border-border px-6 py-3 font-medium"
        >
          Watch How It Works
        </a>
      </div>
      <p class="mt-2 text-xs text-muted">
        Trusted by B2B teams using HubSpot to prioritize pipeline and customers
      </p>
      <div
        class="mt-8 flex aspect-video w-full items-center justify-center rounded-lg border-2 border-dashed border-border px-6 text-center text-sm text-muted"
      >
        <span>
          Screenshot placeholder — prioritized account list
          ("this week your team should focus on")
        </span>
      </div>
    </div>
  </section>

  <!-- Section 2 — Metrics -->
  <section aria-label="Results" class="border-b border-border bg-surface">
    <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 px-6 py-12 md:grid-cols-4">
      {metrics.map((m) => (
        <div class="flex flex-col items-center text-center">
          <span class="text-4xl font-semibold">{m.value}</span>
          <span class="mt-1 text-xs uppercase tracking-widest text-muted">{m.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 3 — The Problem -->
  <section id="problem" class="border-b border-border">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">The Problem</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        Your team is busy. They are just not focused on the right things.
      </h2>
      <p class="mt-6 text-lg text-muted">Most teams:</p>
      <ul class="mt-4 grid gap-3">
        {problemPoints.map((p) => (
          <li class="flex gap-3 text-base">
            <span
              class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg text-muted">
        In most cases, 20 to 30 percent of real opportunity is not being touched. Your
        CRM already has the signals. Your team just cannot see what matters.
      </p>
    </div>
  </section>

  <!-- Section — The Old Way -->
  <section id="old-way" class="border-b border-border bg-surface">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">The Old Way</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        The old way does not work
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-muted">
            Teams rely on:
          </h3>
          <ul class="mt-4 grid gap-3">
            {oldWayMethods.map((item) => (
              <li class="flex gap-3 text-base">
                <span
                  class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                ></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-muted">
            So what happens:
          </h3>
          <ul class="mt-4 grid gap-3">
            {oldWayOutcomes.map((item) => (
              <li class="flex gap-3 text-base">
                <span
                  class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                ></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="mt-12 text-lg text-muted">
        It looks like activity. It is not real progress.
      </p>
    </div>
  </section>

  <!-- Section 4 — A Better Way -->
  <section id="better-way" class="border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">A Better Way</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        You do not need more tools
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-muted">
        You need a system that tells your team where to focus, what matters right now,
        and what to do next. We set that up inside your HubSpot.
      </p>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-muted">
            A system that tells your team:
          </h3>
          <ul class="mt-4 grid gap-3">
            {systemSignals.map((s) => (
              <li class="flex gap-3 text-base">
                <span
                  class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                ></span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-border p-6">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-muted">
            So your team:
          </h3>
          <ul class="mt-4 grid gap-3">
            {systemOutcomes.map((s) => (
              <li class="flex gap-3 text-base">
                <span
                  class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                ></span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5 — What You Get -->
  <section id="what-you-get" class="border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">What We Do</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        We fix what your team works on
      </h2>
      <p class="mt-6 max-w-3xl text-lg text-muted">
        We go into your HubSpot and rebuild how your team decides:
      </p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {services.map((s) => (
          <div class="rounded-lg border border-border p-6">
            <h3 class="text-lg font-semibold">{s.name}</h3>
            <p class="mt-2 text-muted">{s.body}</p>
          </div>
        ))}
      </div>
      <div
        class="mt-12 flex aspect-video w-full items-center justify-center rounded-lg border-2 border-dashed border-border px-6 text-center text-sm text-muted"
      >
        <span>Screenshot placeholder — scored account list / weekly focus view</span>
      </div>
    </div>
  </section>

  <!-- Section — What This Looks Like -->
  <section id="what-this-looks-like" class="border-b border-border bg-surface">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">What This Looks Like</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        This is what most teams see after we run it
      </h2>
      <p class="mt-6 text-lg text-muted">This week your team should focus on:</p>
      <ul class="mt-4 grid gap-3">
        {weeklyFocus.map((item) => (
          <li class="flex gap-3 text-base">
            <span
              class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg text-muted">
        Most teams are not working at least half of this.
      </p>
    </div>
  </section>

  <!-- Section — When Something Matters -->
  <section id="when-something-matters" class="border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">When Something Matters</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        Your system responds. Your team knows what to do.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {signalFlow.map((item) => (
          <div class="rounded-lg border border-border p-6">
            <h3 class="text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-muted">{item.body}</p>
            {item.example && (
              <p class="mt-3 text-sm italic text-muted">Example: “{item.example}”</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section — How It Works -->
  <section id="how-it-works" class="border-b border-border bg-surface">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">How It Works</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        We set it up. It runs.
      </h2>
      <ul class="mt-8 grid gap-3">
        <li class="flex gap-3 text-base">
          <span
            class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
            aria-hidden="true"
          ></span>
          <span>No new system to learn</span>
        </li>
        <li class="flex gap-3 text-base">
          <span
            class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
            aria-hidden="true"
          ></span>
          <span>No dashboards to manage</span>
        </li>
      </ul>
      <p class="mt-8 text-lg text-muted">We:</p>
      <ul class="mt-4 grid gap-3">
        {howItRunsActions.map((item) => (
          <li class="flex gap-3 text-base">
            <span
              class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg text-muted">
        Then we wire it into HubSpot so it works in the background.
      </p>
    </div>
  </section>

  <!-- Section — What Changes -->
  <section id="what-changes" class="border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid gap-12 md:grid-cols-2">
        <div>
          <p class="text-xs uppercase tracking-widest text-muted">What your team sees</p>
          <ul class="mt-6 grid gap-3">
            {teamSees.map((item) => (
              <li class="flex gap-3 text-base">
                <span
                  class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                ></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-muted">What you get</p>
          <ul class="mt-6 grid gap-3">
            {youGet.map((item) => (
              <li class="flex gap-3 text-base">
                <span
                  class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                ></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section — Why This Is Different -->
  <section id="why-different" class="border-b border-border bg-surface">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">Why This Is Different</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        This is not another tool
      </h2>
      <ul class="mt-8 grid gap-3">
        {notNeeded.map((item) => (
          <li class="flex gap-3 text-base">
            <span
              class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg text-muted">
        You need clarity. We give you that and make it usable inside your current system.
      </p>
    </div>
  </section>

  <!-- Section — The Offer -->
  <section id="offer" class="border-b border-border">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <p class="text-xs uppercase tracking-widest text-muted">The Offer</p>
      <h2 class="mt-2 text-3xl font-semibold leading-tight md:text-4xl">
        We rebuild your system in two weeks
      </h2>
      <p class="mt-6 text-lg text-muted">You get:</p>
      <ul class="mt-4 grid gap-3">
        {offerIncludes.map((item) => (
          <li class="flex gap-3 text-base">
            <span
              class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <ul class="mt-8 grid gap-2 text-lg text-muted">
        <li>No long implementation.</li>
        <li>No extra work for your team.</li>
      </ul>
    </div>
  </section>

  <!-- Section 6 — Social Proof -->
  <section id="social-proof" class="border-b border-border bg-surface">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid gap-12 md:grid-cols-2">
        <figure class="flex flex-col gap-4">
          <blockquote class="text-xl leading-relaxed">
            "BoostIdeal and their team helped us define what our true ideal customer
            actually looks like for Scrappy ABM, and provided the tools to track and
            prioritize our target accounts automatically."
          </blockquote>
          <figcaption class="flex items-center gap-4">
            <div
              class="h-12 w-12 flex-none rounded-full border-2 border-dashed border-border"
              aria-hidden="true"
            ></div>
            <div>
              <p class="font-semibold">Mason Cosby</p>
              <p class="text-sm text-muted">CEO, Scrappy ABM</p>
            </div>
          </figcaption>
        </figure>

        <figure class="flex flex-col gap-4">
          <blockquote class="text-xl leading-relaxed">
            "BoostIdeal replaces the guesswork with grounded data. We can verify whether
            our clients are targeting the right accounts before we build anything, which
            improves performance and protects our team's time."
          </blockquote>
          <figcaption class="flex items-center gap-4">
            <div
              class="h-12 w-12 flex-none rounded-full border-2 border-dashed border-border"
              aria-hidden="true"
            ></div>
            <div>
              <p class="font-semibold">Nikki Hershik</p>
              {/* NEEDS CONFIRMATION — company name not in source files */}
              <p class="text-sm text-muted">Company TBD</p>
            </div>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Section 7 — Who It's For -->
  <section id="who-its-for" class="border-b border-border">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h2 class="text-3xl font-semibold leading-tight md:text-4xl">
        This is for you if…
      </h2>
      <ul class="mt-8 grid gap-3">
        {fitChecklist.map((item) => (
          <li class="flex gap-3 text-base">
            <span
              class="mt-[0.55em] h-1.5 w-1.5 flex-none rounded-full bg-accent"
              aria-hidden="true"
            ></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Section 8 — Mid-Page CTA -->
  <section aria-label="Mid-page CTA" class="border-b border-border bg-surface">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-6 py-20 text-center">
      <h2 class="text-3xl font-semibold leading-tight md:text-4xl">
        Not sure where your team's focus is going?
      </h2>
      <p class="text-lg text-muted">
        Upload your accounts and we will show you what is being missed.
      </p>
      <button
        type="button"
        data-open-contact
        class="mt-2 rounded-md bg-accent px-6 py-3 font-medium text-accent-fg"
      >
        See What You're Missing
      </button>
    </div>
  </section>

  <!-- Section 9 — About -->
  <section id="about" class="border-b border-border">
    <div
      class="mx-auto grid max-w-5xl gap-10 px-6 py-20 md:grid-cols-[1fr_1.5fr] md:items-center"
    >
      <div
        class="flex aspect-square w-full items-center justify-center rounded-lg border-2 border-dashed border-border text-center text-sm text-muted"
      >
        <span class="px-4">Founder headshot / team photo placeholder</span>
      </div>
      <div>
        <h2 class="text-3xl font-semibold leading-tight md:text-4xl">
          We built this because the problem kept showing up.
        </h2>
        <p class="mt-6 text-lg text-muted">
          We work with B2B teams that are not lacking effort. They are lacking clarity.
          After seeing the same pattern — good CRM data, active reps, and still too many
          missed opportunities — we built BoostIdeal to fix it. We go inside your
          HubSpot, rebuild how your team decides what to work, and make sure the right
          accounts, deals, and customers are getting attention. No black box. No
          guesswork. Just a clear system your team will actually use.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 10 — Final CTA -->
  <section aria-label="Final CTA">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-6 py-20 text-center">
      <h2 class="text-3xl font-semibold leading-tight md:text-4xl">
        See what your team is missing
      </h2>
      <p class="text-lg text-muted">
        We will show you where your revenue is and what to do next.
      </p>
      <button
        type="button"
        data-open-contact
        class="mt-2 rounded-md bg-accent px-6 py-3 font-medium text-accent-fg"
      >
        Upload your accounts
      </button>
      <button
        type="button"
        data-open-contact
        class="mt-1 text-sm text-muted underline underline-offset-4"
      >
        Message Peter
      </button>
    </div>
  </section>
</Base>
